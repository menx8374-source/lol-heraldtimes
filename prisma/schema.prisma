// Prisma schema — LoL まとめ速報サイト
// データ層決定: SQLite + Prisma（architecture.md 参照）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 記事本体。本文は見出し/段落/引用のブロック配列を JSON で保持し、
/// 「1本の長文ベタ書き」にしないための構造化データとする（F1・F7）。
model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  /// ArticleBodyBlock[] を JSON シリアライズしたもの（lib/article-body.ts で検証・パース）
  body          Json
  /// サムネイル画像URL。未設定時はカテゴリ由来のプレースホルダーを表示する。
  thumbnailUrl  String?
  /// 閲覧数指標（F3 で加算ロジックを実装予定。本スプリントはシード値のみ）
  viewCount     Int      @default(0)
  /// 公開状態（F9 安全フィルタのゲート）: "published"（公開・閲覧サイトに表示）| "held"（保留・非公開）。
  /// 公開記事は必ず安全フィルタ通過済みという不変条件を保つため、閲覧系クエリは必ずこの列で絞り込む。
  status        String   @default("published")
  /// 保留理由コード（F9）: "ng_word" | "missing_source" | "personal_attack" | "duplicate"。
  /// status="held" のときのみ設定される（保留キューの記録に使う）。
  heldReason    String?
  /// 保留理由の詳細メッセージ（人間可読）。status="held" のときのみ設定される。
  heldDetail    String?
  /// 未確定・噂レベルの情報と判定された場合に true（F9）。true でも公開はされるが、
  /// 記事に「未確認」ラベルを表示する対象になる。
  unconfirmed   Boolean  @default(false)
  publishedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags    ArticleTag[]
  sources ArticleSource[]
  collectedItems CollectedItem[]

  @@index([publishedAt])
  @@index([category])
  @@index([status])
}

/// 記事の出典リンク。1記事につき1件以上を必須とする（F1・F9 出典欠落チェックの土台）。
model ArticleSource {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 出典元サービス名（reddit / 5ch / riot-official など）
  label     String
  url       String

  @@index([articleId])
}

/// タグ（チャンピオン名など）。カテゴリより粒度が細かい分類軸。
model Tag {
  id      String       @id @default(cuid())
  name    String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// 収集パイプライン（F5）が各ソースから取り込んだ「収集アイテム」。
/// 出典URLを必ず持つ（アダプタ側で欠落アイテムを弾いてから保存する）。
/// normalizedUrl のユニーク制約により、同一URLの再取込は新規行を増やさず既存行を更新する
/// （F6: 同一URLの二重取込みを1件にまとめる仕組みの土台）。
model CollectedItem {
  id            String   @id @default(cuid())
  /// ソース種別: "reddit" | "5ch" | "riot"
  sourceType    String
  /// 収集元の元URL（出典。表示・正規化前の生値を保持）
  sourceUrl     String
  /// 正規化後URL（重複判定キー）
  normalizedUrl String   @unique
  /// 原題（スレッドタイトル／記事タイトル）
  title         String
  /// 取得本文または反応抜粋
  content       String
  /// ソース側での投稿・取得日時
  fetchedAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 記事化候補キューでの状態: "pending"（未処理）| "queued"（記事化候補）
  /// | "duplicate"（類似アイテムに敗れ候補から除外）| "articled"（記事化済み）
  /// | "generation_failed"（AI記事生成に失敗。F7: 他候補の生成は継続し、この行に理由を記録する）
  status        String   @default("pending")
  articleId     String?
  article       Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  /// 生成失敗時のエラーメッセージ（F7）。status="generation_failed" のときのみ設定される。
  generationError String?

  @@index([sourceType])
  @@index([status])
}

/// ソースごとの収集実行ログ（F5: 実行間隔の判定・1ソース失敗の記録に使う）。
model SourceFetchLog {
  id           String   @id @default(cuid())
  sourceType   String
  runAt        DateTime @default(now())
  /// "success" | "failure"
  status       String
  itemCount    Int      @default(0)
  errorMessage String?

  @@index([sourceType, runAt])
}
