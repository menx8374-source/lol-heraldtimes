// Prisma schema — LoL まとめ速報サイト
// データ層決定: SQLite + Prisma（architecture.md 参照）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 記事本体。本文は見出し/段落/引用のブロック配列を JSON で保持し、
/// 「1本の長文ベタ書き」にしないための構造化データとする（F1・F7）。
model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String
  /// ArticleBodyBlock[] を JSON シリアライズしたもの（lib/article-body.ts で検証・パース）
  body          Json
  /// サムネイル画像URL。未設定時はカテゴリ由来のプレースホルダーを表示する。
  thumbnailUrl  String?
  /// 閲覧数指標（F3 で加算ロジックを実装予定。本スプリントはシード値のみ）
  viewCount     Int      @default(0)
  /// 公開状態（F9 安全フィルタのゲート／拡張E7 運営CMS）: "published"（公開・閲覧サイトに表示）
  /// | "held"（保留・非公開） | "rejected"（運営が却下・非公開） | "scheduled"（予約公開待ち・非公開）。
  /// 公開記事は必ず安全フィルタ通過済みという不変条件を保つため、閲覧系クエリは必ずこの列で絞り込む
  /// （published 以外は一切公開サイトに出さない）。
  status        String   @default("published")
  /// 保留理由コード（F9）: "ng_word" | "missing_source" | "personal_attack" | "duplicate"。
  /// status="held" のときのみ設定される（保留キューの記録に使う）。
  heldReason    String?
  /// 保留理由の詳細メッセージ（人間可読）。status="held" のときのみ設定される。
  heldDetail    String?
  /// 予約公開時刻（拡張E7）。status="scheduled" のときのみ設定され、この時刻以降に
  /// パイプライン実行（promoteScheduledArticles）で status="published" に昇格する。
  scheduledAt   DateTime?
  /// ピン留め（注目記事固定、拡張E7）。true の記事はトップの注目記事・各一覧の先頭に優先表示される。
  pinned        Boolean  @default(false)
  /// 未確定・噂レベルの情報と判定された場合に true（F9）。true でも公開はされるが、
  /// 記事に「未確認」ラベルを表示する対象になる。
  unconfirmed   Boolean  @default(false)
  /// コメント数（拡張E1）。現時点ではコメント投稿機能自体は無く、シード値/将来のE2実装が加算する
  /// 表示専用のカウンタとしてカードに表示する。
  commentCount  Int      @default(0)
  publishedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags    ArticleTag[]
  sources ArticleSource[]
  collectedItems CollectedItem[]
  reactions ArticleReaction[]
  comments ArticleComment[]
  views   ArticleView[]

  @@index([publishedAt])
  @@index([category])
  @@index([status])
  @@index([status, scheduledAt])
}

/// 記事の出典リンク。1記事につき1件以上を必須とする（F1・F9 出典欠落チェックの土台）。
model ArticleSource {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 出典元サービス名（reddit / 5ch / riot-official など）
  label     String
  url       String

  @@index([articleId])
}

/// タグ（チャンピオン名など）。カテゴリより粒度が細かい分類軸。
model Tag {
  id      String       @id @default(cuid())
  name    String       @unique
  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// 収集パイプライン（F5）が各ソースから取り込んだ「収集アイテム」。
/// 出典URLを必ず持つ（アダプタ側で欠落アイテムを弾いてから保存する）。
/// normalizedUrl のユニーク制約により、同一URLの再取込は新規行を増やさず既存行を更新する
/// （F6: 同一URLの二重取込みを1件にまとめる仕組みの土台）。
model CollectedItem {
  id            String   @id @default(cuid())
  /// ソース種別: "reddit" | "5ch" | "riot"
  sourceType    String
  /// 収集元の元URL（出典。表示・正規化前の生値を保持）
  sourceUrl     String
  /// 正規化後URL（重複判定キー）
  normalizedUrl String   @unique
  /// 原題（スレッドタイトル／記事タイトル）
  title         String
  /// 取得本文または反応抜粋
  content       String
  /// サムネイル画像URL（拡張E19）。アダプタが取得元の画像（Riotスプラッシュ/Reddit投稿画像/
  /// YouTube・Twitchサムネイル）を設定する。未設定は null（表示側が既定画像にフォールバックする）。
  imageUrl      String?
  /// ソース側での投稿・取得日時
  fetchedAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// 記事化候補キューでの状態: "pending"（未処理）| "queued"（記事化候補）
  /// | "duplicate"（類似アイテムに敗れ候補から除外）| "articled"（記事化済み）
  /// | "generation_failed"（AI記事生成に失敗。F7: 他候補の生成は継続し、この行に理由を記録する）
  status        String   @default("pending")
  articleId     String?
  article       Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  /// 生成失敗時のエラーメッセージ（F7）。status="generation_failed" のときのみ設定される。
  generationError String?

  @@index([sourceType])
  @@index([status])
}

/// 絵文字リアクション（拡張E1）。記事1件×絵文字1種につき1行で件数を保持する
/// （ログイン無し方針のため、ユーザー単位の多重投稿防止は行わず、UI側の連打抑止のみで足りる仕様）。
model ArticleReaction {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 対象絵文字（lib/reactions.ts の REACTION_EMOJIS のいずれか）
  emoji     String
  count     Int     @default(0)

  @@unique([articleId, emoji])
  @@index([articleId])
}

/// 記事への匿名コメント（拡張E2）。ログイン機能は無い方針のため誰でも投稿できるが、
/// 既存の安全フィルタ（NGワード・個人中傷/晒し。lib/moderation）で判定し、通過したものだけ
/// status="published" として公開・Article.commentCount に加算する。不通過は status="held" として
/// 記録だけ残し、公開サイトには一切表示しない（保留コメントの一覧UIはE7の対象）。
/// 返信スレッド・賛否リアクション（拡張E8）: parentId を持つ行は返信で、1階層のみ
/// （返信への返信も大元の親にぶら下げる。lib/comments-db.ts の createComment が解決する）。
model ArticleComment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  /// 記事内の表示連番（1始まり）。トップレベル・返信を通じて同一記事内で一意。
  number    Int
  /// 匿名ハンドル名。未入力時は既定値（lib/comments.ts の DEFAULT_COMMENT_NAME）。
  name      String
  /// コメント本文（閲覧者入力。表示時は必ずReact子要素として描画しHTMLとして解釈しない＝XSS対策）。
  body      String
  /// 本文から抽出した ">>N" 形式のアンカー参照先番号（同記事内）。JSON配列。無ければ null。
  anchors   Json?
  createdAt DateTime @default(now())
  /// 公開状態: "published"（一覧に表示）| "held"（安全フィルタ不通過・非公開）。
  status    String   @default("published")
  /// 保留理由コード: "ng_word" | "personal_attack"。status="held" のときのみ設定される。
  heldReason String?
  /// 返信先の親コメントID（拡張E8）。トップレベルコメントは null。1階層のみのため、
  /// 返信の返信も常にトップレベルコメントを指す。
  parentId  String?
  parent    ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ArticleComment[] @relation("CommentReplies")
  /// 👍 Good の件数（拡張E8）。ログイン無し方針のためユーザー単位の多重防止はせず、
  /// UI側の連打抑止（楽観更新・二重送信防止）のみで足りる仕様。
  goodCount Int      @default(0)
  /// 👎 Bad の件数（拡張E8）。goodCount と同様の方針。
  badCount  Int      @default(0)

  @@unique([articleId, number])
  @@index([articleId, status])
  @@index([status, createdAt])
  @@index([articleId, parentId])
}

/// 記事の閲覧イベント（拡張E4: 期間別ランキングF3拡張）。累計 Article.viewCount とは別に、
/// 直近N日の閲覧数を集計するための軽量な1行1閲覧のログ。行数は増え続けるため、集計クエリは
/// 必ず viewedAt の cutoff で絞り込み、cutoff より古い行は集計対象から単に除外する
/// （物理削除はこのスプリントでは行わない。将来的に cutoff より十分に古い行を定期削除する
/// バッチ処理を追加する余地がある）。
model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([articleId])
  @@index([viewedAt])
}

/// ソースごとの収集実行ログ（F5: 実行間隔の判定・1ソース失敗の記録に使う）。
model SourceFetchLog {
  id           String   @id @default(cuid())
  sourceType   String
  runAt        DateTime @default(now())
  /// "success" | "failure"
  status       String
  itemCount    Int      @default(0)
  errorMessage String?

  @@index([sourceType, runAt])
}

/// 統合パイプライン（F10: 収集→重複排除→生成→タイトル→安全フィルタ→公開）の実行ログ（F11）。
/// 各実行ごとに件数サマリを残し、Sprint 9 の運営ダッシュボードが読み取れるようにする。
/// この行の作成自体が失敗しても実行結果には影響させない（呼び出し側でcatchするだけ）。
model PipelineRunLog {
  id                  String   @id @default(cuid())
  startedAt           DateTime
  finishedAt          DateTime
  /// "success"（想定内の個別失敗を含め正常終了） | "failure"（想定外の例外で異常終了）
  status              String
  collectedCount      Int      @default(0)
  candidateCount      Int      @default(0)
  generationSucceeded Int      @default(0)
  generationFailed    Int      @default(0)
  publishedCount      Int      @default(0)
  heldCount           Int      @default(0)
  /// status="failure" のときのみ設定される、想定外の例外メッセージ。
  errorMessage        String?

  @@index([startedAt])
}
