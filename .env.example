# SQLite データベースファイルの場所（prisma/schema.prisma から見た相対パス）。
# ローカル開発ではこの既定値のままで動作する（秘密情報ではない）。
DATABASE_URL="file:./dev.db"

# LLM本接続（拡張E24）。GENERATION_MODE=live かつ ANTHROPIC_API_KEY 設定時のみ
# Anthropic Claude(Haiku)へ本接続する（未設定ならMockLLMClientにフォールバックし課金しない）。
# ANTHROPIC_API_KEY は https://console.anthropic.com で発行するAPIキー。
# **秘密情報のため必ず.envのみで設定し、コミットしない**（本ファイルにはキー名のみを記載する）。
# ANTHROPIC_MODEL は既定 claude-haiku-4-5（コスト最小のHaiku固定）。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# 収集パイプライン（Sprint 3, F5）の設定。秘密情報ではなく、いずれも任意（未設定時は既定値）。
# COLLECTION_MODE=mock
# COLLECTION_REDDIT_MAX_ITEMS=10
# COLLECTION_REDDIT_MIN_INTERVAL_MS=600000
# COLLECTION_5CH_MAX_ITEMS=10
# COLLECTION_5CH_MIN_INTERVAL_MS=600000
# COLLECTION_RIOT_MAX_ITEMS=20
# COLLECTION_RIOT_MIN_INTERVAL_MS=1800000
# COLLECTION_RIOT_NEWS_MAX_ITEMS=4
# COLLECTION_RIOT_NEWS_MIN_INTERVAL_MS=1800000

# 収集アダプタの本接続（拡張E15）。COLLECTION_MODE=live にすると、実装済みソース(riot)は
# Riot Data Dragon（公式の静的データCDN。APIキー不要・公開）から本物のデータを収集する。

# 収集アダプタ: Reddit本接続（拡張E46でArctic Shiftへ切替、成長G8で速報性向上）。
# COLLECTION_MODE=live にすると、Arctic Shift（arctic-shift.photon-reddit.com・無認証・無料）から
# r/leagueoflegends の投稿を取得する（英語のまま。翻訳は拡張E47）。
# **キー不要**（旧OAuth用 REDDIT_CLIENT_ID/REDDIT_CLIENT_SECRET は廃止）。
# 以下はいずれも秘密情報ではなく任意（未設定時は既定値）。
# REDDIT_USER_AGENT: Arctic Shiftへ付与するUA文字列（秘密ではない。既定の説明的UAあり）。
# REDDIT_MIN_AGE_HOURS / REDDIT_MAX_AGE_HOURS: 取得窓＝何時間前〜何時間前の投稿を対象にするか
#   （既定12/72、成長G8で日粒度から時間粒度・前寄せに変更）。
# REDDIT_MIN_SCORE: 「古い」投稿(監視ウィンドウ外)に適用するスコア下限（既定50）。
# REDDIT_MAX_THREADS: 「古い」投稿から収集対象にする投稿数の上限（既定5）。
# REDDIT_MAX_COMMENTS: 1投稿あたり取り込む上位コメント数の上限（既定20）。
# REDDIT_MONITOR_MAX_AGE_HOURS（成長G8 F-G8-2）: 投稿からこの時間以内なら「新しい投稿」として
#   score足切りをせずPost保存・監視対象に入れる（既定24。バックフィル遅延で投稿直後はscore=1の
#   ため、記事化は既存HotnessEvaluatorの増加率＝初速判定に委ねる）。
# REDDIT_MONITOR_MIN_COMMENTS（成長G8 F-G8-2）: 新しい投稿に適用するnum_comments下限
#   （ノイズ抑制、既定1）。
# REDDIT_MAX_MONITOR_CANDIDATES（成長G8 F-G8-2）: 新しい投稿から選抜する件数の上限
#   （監視対象の暴走防止、既定5）。
# REDDIT_DISCUSSION_COMMENT_SLOTS（成長G8 F-G8-3）: コメント選抜でscore上位に加えて確保する
#   「返信の多い議論コメント」の枠数（既定2。Arctic Shiftが返信数を返さない場合は現状のscore降順
#   のみになり無効化される）。
# REDDIT_REQUEST_DELAY_MS: 連続fetch間に入れるディレイ(ms)（既定1000）。
# REDDIT_USER_AGENT=
# REDDIT_MIN_AGE_HOURS=12
# REDDIT_MAX_AGE_HOURS=72
# REDDIT_MIN_SCORE=50
# REDDIT_MAX_THREADS=5
# REDDIT_MAX_COMMENTS=20
# REDDIT_MONITOR_MAX_AGE_HOURS=24
# REDDIT_MONITOR_MIN_COMMENTS=1
# REDDIT_MAX_MONITOR_CANDIDATES=5
# REDDIT_DISCUSSION_COMMENT_SLOTS=2
# REDDIT_REQUEST_DELAY_MS=1000

# 収集アダプタ: Riot公式ニュース本接続（リファクタリングS7b F-S7b-2）。COLLECTION_MODE=live にすると、
# https://www.leagueoflegends.com/ja-jp/news/ からDev Blog/チャンピオン・スキン/eスポーツ/
# ゲームアップデートの記事をURLルール（AI分類なし）で分類し収集する（パッチノート・community種別は対象外）。
# **キー不要**（公式公開ページ）。秘密情報ではなく任意（未設定時は既定値）。
# RIOT_NEWS_MAX_ITEMS: 1回の収集で取得する最新記事数の上限（既定4）。
# RIOT_NEWS_REQUEST_DELAY_MS: 連続fetch間に入れるディレイ(ms)（既定1000）。
# RIOT_NEWS_MAX_ITEMS=4
# RIOT_NEWS_REQUEST_DELAY_MS=1000

# 収集アダプタ: X（旧Twitter）本接続（成長G7 F-G7-2）。COLLECTION_MODE=live でも、xソースは
# X_API_KEY 設定時のみ live（GetXAPI advanced_search）になり、未設定なら mock(fixture)に自動フォールバック
# する（無課金・本体を止めない。他ソースのlive/mock判定とは独立）。
# X_API_KEY: **秘密情報のため必ず.envのみで設定し、コミットしない**（GetXAPIのAPIキー。
# https://getxapi.com 等で取得。$0.05/1,000tweets・$0.10無料クレジット）。
# X_API_PROVIDER: 既定 getxapi（将来 twitterapi.io 等のフェイルオーバー追加用、秘密情報ではない）。
# X_SEARCH_QUERIES: 検索クエリを`|||`区切りで複数指定（秘密情報ではない、未設定時は既定2クエリ
#   ＝国内lang:ja min_faves:100 / 海外lang:en min_faves:1000）。
# X_SINCE_HOURS: 重複取得防止のsince:窓（時間、既定24）。
# X_REQUEST_DELAY_MS: 連続fetch間に入れるディレイ(ms)（既定1000）。
# X_API_KEY=
# X_API_PROVIDER=getxapi
# X_SEARCH_QUERIES=
# X_SINCE_HOURS=24
# X_REQUEST_DELAY_MS=1000
# COLLECTION_X_MAX_ITEMS=10
# COLLECTION_X_MIN_INTERVAL_MS=900000
# HOTNESS_X_MIN_SCORE=100
# HOTNESS_X_MIN_COMMENTS=30

# PBE関連ツイート取得層（PBE-S3 F-PBE3-1）。Spideraxe氏(@Spideraxe30)・Phroxzon氏(@RiotPhroxzon)の
# PBE関連ツイートを出典付きで取得する（`src/lib/collection/adapters/pbe-x-source.ts`）。
# X_API_KEY（上記と共通）設定時のみ live、未設定なら mock(fixture) に自動フォールバックする（無課金）。
# 本スプリントは取得層のみで、記事化・opt-in配線はPBE-S5で行う（既存挙動に影響なし）。
# PBE_X_QUERIES: 検索クエリを`|||`区切りで指定（秘密情報ではない。未設定時の既定は
#   `(from:Spideraxe30 OR from:RiotPhroxzon) (PBE OR patch OR パッチ) -filter:retweets`）。
# PBE_X_QUERIES=

# 収集アダプタ: 5ch本接続（拡張E18・ベストエフォート）。COLLECTION_MODE=live にすると、
# 対象板の subject.txt→スレ絞り込み→dat を取得しスレッドダンプ形式に整形する。5chは公式APIが無く
# HTML/dat仕様変更で壊れやすい前提。取得失敗/板無効時は空配列＋ログでスキップ（他ソースは継続）。
# **転載リスクに留意**: 逐語転載は著作権・5chの転載規約に抵触し得るため、削除依頼(CONTACT_EMAIL)
# には即応すること。robots/利用規約の尊重は運営者責務。
# FIVECH_BOARDS は "server/board" をカンマ区切りで指定（例 "egg.5ch.net/livegame"）。
# 秘密情報ではなく任意（未設定時は既定板を使用）。
# FIVECH_USER_AGENT は5ch側が空/既定UAを弾くことがあるため必須級の説明的UA文字列
# （秘密ではない。既定の説明的UAが用意されているため通常は未設定でも動く）。
# FIVECH_BOARDS=
# FIVECH_USER_AGENT=

# 5ch収集の改善（拡張E39）。秘密情報ではなく任意。
# FIVECH_MIN_RES_COUNT: スレ選別のレス数下限（過疎スレ排除。既定20）。
# FIVECH_REQUEST_DELAY_MS: subject/dat連続取得の間に入れるディレイ(ms)（既定1500）。
# FIVECH_MIN_RES_COUNT=20
# FIVECH_REQUEST_DELAY_MS=1500

# AIまとめ記事生成（Sprint 4, F7 / 拡張E24で本接続対応）の設定。秘密情報ではなく任意
# （未設定時は既定値mock）。mock: 決定論的モックLLM実装（APIキー不要・既定・無課金）。
# live: ANTHROPIC_API_KEY設定時のみAnthropic(Haiku)へ本接続（未設定ならmockに自動フォールバック）。
# GENERATION_MODE=mock

# riot（パッチ）記事の構成モード（拡張E41）。秘密情報ではなく任意（未設定時は既定fact）。
# fact: 事実速報（見出し「パッチ<番号>が公開」＋一般的事実段落＋出典URL、LLM不使用・捏造なし）。
# summary: 従来のLLM要約→決定的抽出→クリーン定型の3段フォールバック（後でLLMまとめに戻す場合に使用）。
# PATCH_ARTICLE_MODE=fact

# 未適用パッチの先行速報＋本番反映後の自動確定（パッチ記事刷新S5、opt-in）。秘密情報ではなく任意
# （未設定時は既定off）。off/未設定では収集・記事化・表示すべて現状と完全同一（回帰ゼロ）。
# on: 現行live版(versions.json先頭)の次パッチの公式ノートが既に公開されていれば、速報バッジ付きで
#   先行記事化する（AI不使用・公式ノート逐語＋注意書きのみ、捏造なし）。本番反映後は`npm run
#   confirm-patch-preview`（scripts/confirm-patch-preview.ts）で同一記事を確定版へ自動更新する
#   （重複記事は作らない。`npm run update-articles`と同じ運用パターンで別途cron等から定期実行する）。
# PATCH_PREVIEW_MODE=off

# PBE（テストサーバー）記事枠 — CommunityDragon自動分のみ・X収集なし・AI不使用（PBE-S4、opt-in）。
# 秘密情報ではなく任意（未設定時は既定off）。off/未設定では収集・記事化・表示すべて現状と完全同一
# （回帰ゼロ・追加コストなし）。
# on: CommunityDragon（raw.communitydragon.org、キー不要・無料）でpbe版≠latest版（本番準備中）を
#   確認できた場合のみ、チャンピオン基本ステータス/cost/cooldown・アイテムの数値diffから
#   未確定バッジ付きのPBE先行記事を生成/上書き更新する（`npm run pbe-article`
#   （scripts/pbe-article.ts）で実行。`confirm-patch-preview`と同じ運用パターンで別途cron等から
#   定期実行する）。スキル効果量は扱わない（公式パッチノート確定待ち）。X（旧Twitter）収集は含まない。
# PBE_ARTICLE_MODE=off

# 反応記事（5ch/reddit）のレス選別モード（リファクタリング S3 F-S3-3）。秘密情報ではなく任意
# （未設定時は既定rules）。要件「AIによる話題性判定・分類・スコアリングは禁止」に合わせ、
# rules: 数値ルール（アンカー会話クラスタ選定＋決定論強調）でレスを選ぶ。AI選別は呼ばない（既定・低コスト）。
# llm: 従来どおりAI（selectReactionReses）でレスを選別する（旧挙動。質の比較用に残置）。
# REACTION_SELECT_MODE=rules

# 話題性判定（HotnessEvaluator、リファクタリング S3 F-S3-1）の閾値設定。秘密情報ではなく任意
# （未設定時は下記の既定値）。Post経路の記事化判定（generateArticlesFromHotPosts、S5a/S5c）で使用。
# ソース別に上書き可能（HOTNESS_5CH_*/HOTNESS_REDDIT_*/HOTNESS_RIOT_*、
# 未指定分は汎用のHOTNESS_MIN_SCORE/HOTNESS_MIN_COMMENTSにフォールバック）。
# HOTNESS_MIN_SCORE=100
# HOTNESS_MIN_COMMENTS=30
# HOTNESS_5CH_MIN_SCORE=0
# HOTNESS_5CH_MIN_COMMENTS=30
# HOTNESS_REDDIT_MIN_SCORE=100
# HOTNESS_REDDIT_MIN_COMMENTS=30
# HOTNESS_RIOT_MIN_SCORE=100
# HOTNESS_RIOT_MIN_COMMENTS=30
# HOTNESS_RIOT_NEWS_MIN_SCORE=100
# HOTNESS_RIOT_NEWS_MIN_COMMENTS=30
# HOTNESS_MIN_SCORE_GROWTH_PER_HOUR=50
# HOTNESS_MIN_COMMENT_GROWTH_PER_HOUR=10
# HOTNESS_MIN_AGE_MINUTES=30
# HOTNESS_MAX_AGE_HOURS=72
# HOTNESS_USE_RANK_SIGNAL=false
# 論争度判定（成長G1 F-G1-1）。commentCount/max(score,1)がこれ以上、またはupvote_ratioがこれ以下で
# isControversial=true（記事化優先＋タイトルが議論寄りになる）。主にreddit向け。
# HOTNESS_MIN_CONTROVERSY_RATIO=0.15
# HOTNESS_MAX_UPVOTE_RATIO=0.80
# 5chはscoreが常時0のためcomment比が発散し判定として無意味なので既定で実質無効（Infinity）。
# 明示的に有効化したい場合のみ設定する。
# HOTNESS_5CH_MIN_CONTROVERSY_RATIO=0.15
# hotness判定を経ずに常に記事化対象とするソース種別（リファクタリング S5c F-S5c-1、S7bでriot-newsを追加）。
# カンマ区切り。公式パッチノート（riot）・公式ニュース（riot-news）は"話題性"で測るべきでない
# 公式情報のため既定で免除する。
# HOTNESS_EXEMPT_SOURCE_TYPES=riot,riot-news

# メトリクス定期更新（リファクタリングS4 F-S4-2）の更新スケジュール（バックオフ）設定。
# 秘密情報ではなく任意（未設定時は下記の既定値）。監視中(Post.monitoring=true)のPostを
# 経過時間帯(early/mid/late/tail)ごとに異なる間隔で再チェックし、maxMonitorHours超で監視終了する。
# `npm run update-metrics`（scripts/update-metrics.ts）で1回実行。cron常駐設定は対象外。
# METRICS_EARLY_INTERVAL_MINUTES: 経過0〜earlyPhaseHoursの間隔(分)（既定10）。
# METRICS_EARLY_PHASE_HOURS: early帯の境界(時間)（既定1）。
# METRICS_MID_INTERVAL_MINUTES: 経過earlyPhaseHours〜midPhaseHoursの間隔(分)（既定30）。
# METRICS_MID_PHASE_HOURS: mid帯の境界(時間、投稿からの絶対経過時間)（既定6）。
# METRICS_LATE_INTERVAL_MINUTES: 経過midPhaseHours〜latePhaseHoursの間隔(分)（既定120）。
# METRICS_LATE_PHASE_HOURS: late帯の境界(時間、投稿からの絶対経過時間)（既定24）。
# METRICS_TAIL_INTERVAL_MINUTES: 経過latePhaseHours〜maxMonitorHours(tail帯)の間隔(分)（既定360）。
# METRICS_MAX_MONITOR_HOURS: これを超えたら監視終了(時間)（既定48）。
# METRICS_MAX_POSTS_PER_RUN: 1回のupdater実行で更新する最大Post数(既定50、API有界化)。
# METRICS_REQUEST_DELAY_MS: 連続fetch間に入れるディレイ(ms)（既定1000）。
# METRICS_EARLY_INTERVAL_MINUTES=10
# METRICS_EARLY_PHASE_HOURS=1
# METRICS_MID_INTERVAL_MINUTES=30
# METRICS_MID_PHASE_HOURS=6
# METRICS_LATE_INTERVAL_MINUTES=120
# METRICS_LATE_PHASE_HOURS=24
# METRICS_TAIL_INTERVAL_MINUTES=360
# METRICS_MAX_MONITOR_HOURS=48
# METRICS_MAX_POSTS_PER_RUN=50
# METRICS_REQUEST_DELAY_MS=1000

# 記事更新（伸びたら条件付き再AI、リファクタリングS6 F-S6-1/F-S6-3）の設定。秘密情報ではなく任意
# （未設定時は下記の既定値）。articleが紐付き(記事化済み)かつ監視中(Post.monitoring=true)のPostのうち、
# Scoreが大きく伸びた／コメントが急増したものだけ数値ルール(AI不使用)で判定して再AI更新する
# （通常は再実行しない。cooldown・maxCount・maxAgeで抑制）。`npm run update-articles`
# （scripts/update-articles.ts）で1回実行。cron常駐設定は対象外。riot（免除ソース）は対象外。
# UPDATE_MIN_SCORE_DELTA: baselineからのScore増加量の下限（既定100。reddit主体）。
# UPDATE_MIN_COMMENT_DELTA: baselineからのコメント数増加量の下限（既定30。5ch/reddit共通。5chはscore
#   が常に0のためこちらのみで実質判定される）。
# UPDATE_COOLDOWN_HOURS: 前回更新（無ければ記事化）からの最短間隔(時間)（既定6）。
# UPDATE_MAX_COUNT: 1記事あたりの最大更新回数（既定2）。
# UPDATE_MAX_AGE_HOURS: 投稿からの経過時間がこれを超えたら更新対象外（既定48）。
# UPDATE_MAX_POSTS_PER_RUN: 1回のupdater実行で調べる最大Post数(既定20、API有界化)。
# UPDATE_REQUEST_DELAY_MS: 連続fetch間に入れるディレイ(ms)（既定1000）。
# UPDATE_MIN_SCORE_DELTA=100
# UPDATE_MIN_COMMENT_DELTA=30
# UPDATE_COOLDOWN_HOURS=6
# UPDATE_MAX_COUNT=2
# UPDATE_MAX_AGE_HOURS=48
# UPDATE_MAX_POSTS_PER_RUN=20
# UPDATE_REQUEST_DELAY_MS=1000

# 生成経路の切替（リファクタリングS5a F-S5a-2）。秘密情報ではなく任意（未設定時は既定post）。
# post: hot判定された未記事化Post（S1〜S4のPost/メトリクス/HotnessEvaluator）だけをAIで記事化する
#   新フロー（既定）。話題性判定は数値ルール(evaluateHotness)のみでAIは使わない。
# collected: 従来のCollectedItem→記事化経路(generateArticlesForQueue)。比較用に残置。
# GENERATION_SOURCE=post

# 統合パイプライン（Sprint 7, F10/F11）の設定。秘密情報ではなく任意（未設定時は既定 5 / 4時間）。
# PIPELINE_MAX_PUBLISH_PER_RUN: 1回のパイプライン実行で公開する記事本数の総数上限（後方互換用。
#   通常運用では下の PIPELINE_MAX_PUBLISH_PER_CATEGORY が主制御になるため未設定でよい）。
PIPELINE_MAX_PUBLISH_PER_RUN=2
# PIPELINE_MAX_PUBLISH_PER_CATEGORY（拡張E48）: 1回の実行でパッチ/メタ・5chの反応・海外の反応を
#   それぞれ独立に公開する本数の上限（既定2＝カテゴリごとに最大2本）。
# PIPELINE_MAX_PUBLISH_PER_CATEGORY=2
# PIPELINE_INTERVAL_MS はcronで実行間隔を制御する運用のため未設定でよい（次回実行予定の表示用途のみ）。
# PIPELINE_INTERVAL_MS=14400000

# サイトの絶対URLベース（Sprint 8, F13）。OGP／構造化データ／サイトマップ／robotsの絶対URL生成に使う。
# 秘密情報ではなく任意（未設定時は http://localhost:3000）。本番デプロイ時のドメインに合わせて設定する。
# SITE_URL=http://localhost:3000

# 広告枠（Sprint 8, F12）に差し込む広告タグ文字列（AdSense等）。秘密情報ではなく任意
# （未設定時は各枠にプレースホルダーを表示）。値は運営者が設定する信頼済みのHTML/スクリプト文字列のみとし、
# 記事本文など閲覧者由来のデータを混ぜないこと。AdSenseアカウント開設・審査申請は本システムの対象外。
# AD_SLOT_ARTICLE_TOP=
# AD_SLOT_ARTICLE_IN_BODY=
# AD_SLOT_ARTICLE_BOTTOM=
# AD_SLOT_SIDEBAR=
# AD_SLOT_LISTING=

# お問い合わせ・掲載削除依頼ページ（Sprint 10, F15）の連絡先メールアドレス。秘密情報ではなく任意
# （未設定時は SITE_URL のホスト名から contact@<host> を自動生成する）。
# CONTACT_EMAIL=

# 運営お知らせバー（拡張E1）にサイト最上部で1行表示するお知らせ文言。秘密情報ではなく任意
# （未設定時はバー自体を表示しない）。
# SITE_NOTICE=

# ブログランキング/外部集客枠（拡張E4）に差し込む外部ランキング（にほんブログ村等）のバナー/
# リンクHTML。秘密情報ではなく任意（未設定時はプレースホルダーを表示）。値は運営者が設定する
# 信頼済みのHTML/スクリプト文字列のみとし、記事本文など閲覧者由来のデータを混ぜないこと。
# BLOG_RANKING_HTML=

# 広告枠の追加種類（拡張E5・収益化拡充）。秘密情報ではなく任意（未設定時はプレースホルダーを表示）。
# 値は運営者が設定する信頼済みのHTML/スクリプト文字列のみとし、閲覧者由来のデータを混ぜないこと。
# AD_SLOT_SIDEBAR_STICKY=  # PCサイドバーで追従(sticky)表示する広告枠
# AD_SLOT_ANCHOR=          # 画面下部固定・閉じるボタン付きのアンカー広告枠（主にモバイル）
# AD_SLOT_MATCHED_CONTENT= # 記事末尾の関連コンテンツ(マッチドコンテンツ)枠

# GA4等アクセス解析タグの計測ID（拡張E5）。秘密情報ではなく任意（未設定時はタグを読み込まない）。
# Cookie同意バナーで「同意する」を選択した閲覧者にのみ読み込む（同意前トラッキング禁止）。
# NEXT_PUBLIC_ プレフィックスはクライアント側での読み込みに必要（計測IDは公開情報であり秘密情報ではない）。
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 運営CMS（拡張E7）の /admin ダッシュボードを保護するBasic認証の資格情報。**秘密情報のため
# 必ず .env のみで設定し、コミットしない**（本ファイルにはキー名のみを記載する）。
# 両方が未設定の場合、/admin へのアクセスは常に拒否される（管理機能ごと無効化。安全側の既定動作）。
# ADMIN_USER=
# ADMIN_PASSWORD=

# サイト全体の一般公開/非公開トグル。true にすると**サイト全体**が上の ADMIN_USER/ADMIN_PASSWORD の
# Basic認証で保護され、一般公開が止まる（公開前の準備・更新中の非公開化に使う。閲覧に認証が必要）。
# 未設定/false で通常どおり一般公開（/admin のみ保護）。切替は .env のこの値変更＋ pm2 restart。
# SITE_PRIVATE=false

# 投稿スケジュール分散（成長G6 F-G6-2）。秘密情報ではなく任意（未設定時は既定 immediate）。
# immediate（既定）: 現状どおり生成記事を即時公開する（挙動を1バイトも変えない）。
# schedule: 反応記事(reddit/5ch)を公開時刻テーブル(07:15/12:15/15:15/18:15/21:15 JST)に分散予約する
#   （status="scheduled"＋scheduledAt割当。promoteScheduledArticlesが到来時に公開へ昇格する）。
#   免除ソース(riot/riot-news、HOTNESS_EXEMPT_SOURCE_TYPES参照)は速報性維持のため常に即時公開。
# PUBLISH_SCHEDULE_MODE=immediate

# 配信導線 — Discord Webhook通知（成長G6 F-G6-3）。**秘密情報のため必ず .env のみで設定し、
# コミットしない**（本ファイルにはキー名のみを記載する）。未設定時は通知は完全no-op（fetchを呼ばない）。
# 設定時、公開された記事のタイトル＋URLをこのWebhook URLへPOSTする。送信失敗は握りつぶし本体を止めない。
# DISCORD_WEBHOOK_URL=
